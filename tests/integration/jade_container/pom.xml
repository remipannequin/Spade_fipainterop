<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jade.port>10099</jade.port>
        <jade.port2>10199</jade.port2>
    </properties>
    <modelVersion>4.0.0</modelVersion>
    <groupId>fr.univlorraine.cran.c2ps</groupId>
    <artifactId>jade-interop</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <distributionManagement>
        <repository>
            <id>gitlab-maven</id>
            <url>https://gitlab.univ-lorraine.fr/api/v4/projects/12981/packages/maven</url>
        </repository>
        <snapshotRepository>
            <id>gitlab-maven</id>
            <url>https://gitlab.univ-lorraine.fr/api/v4/projects/12981/packages/maven</url>
        </snapshotRepository>
    </distributionManagement>
    <build>
        <sourceDirectory>src/</sourceDirectory>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <mainClass>jade.Boot</mainClass>
                    <arguments>
                        <argument>-port</argument><argument>${jade.port}</argument>
                        <argument>-name</argument><argument>Pf</argument>
                        <argument>pa0:fr.univlorraine.cran.c2ps.PingAgent(pa1);pa1:fr.univlorraine.cran.c2ps.PingAgent(pa0)</argument>
                    </arguments>
                </configuration>
                <executions>
                    <execution>
                        <id>main1</id>
                        <configuration>
                            <mainClass>jade.Boot</mainClass>
                            <arguments>
                                <!--<argument>-jade_http_mtp_parser</argument><argument></argument>-->
                                <argument>-gui</argument>
                                <argument>-name</argument><argument>Platform1</argument>
                                <argument>-port</argument><argument>${jade.port}</argument>
                                <argument>-mtps</argument><argument>jade.mtp.http.MessageTransportProtocol(http://localhost:7778/JADE)</argument>
                            </arguments>
                        <jvmArguments>
                            <jvmArgument>--add-exports java.xml/com.sun.org.apache.xerces.internal.jaxp=ALL-UNNAMED</jvmArgument>
                        </jvmArguments>
                        </configuration>
                    </execution>
<execution>
                        <id>main2</id>
                        <configuration>
                            <mainClass>jade.Boot</mainClass>
                            <arguments>
                                <!--<argument>-jade_http_mtp_parser</argument><argument></argume>-->
                                <argument>-name</argument><argument>Platform2</argument>
                                <argument>-port</argument><argument>${jade.port2}</argument>
                                <argument>-mtps</argument><argument>jade.mtp.http.MessageTransportProtocol(http://localhost:7779/JADE)</argument>
                            </arguments>
                        <jvmArguments>
                        </jvmArguments>
                        </configuration>
                    </execution>

                </executions>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <!-- Repository for tilab's jade
        <repository>
            <id>tilab</id>
            <url>https://jade.tilab.com/maven/</url>
        </repository>
        -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <!--<groupId>com.tilab.jade</groupId>-->
            <groupId>com.gitlab.jade-project</groupId>
            <artifactId>jade</artifactId>
            <version>master-SNAPSHOT</version>
        </dependency>
    </dependencies>
</project>
